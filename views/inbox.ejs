<!doctype html>
<html lang="id" class="inbox-html">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>WhatsApp Inbox</title>
<link rel="stylesheet" href="/css/base.css?v=1.7.0">
<link rel="stylesheet" href="/css/inbox.css?v=1.7.0">
</head>
<body class="inbox-page">
<div id="app" class="wa-shell">
  <aside class="sidebar">
    <header class="sidebar-head">
      <div class="avatar">W</div>
      <div class="sidebar-title">
        <strong>WhatsApp Inbox</strong>
        <small>Customer Service</small>
      </div>
      <a class="icon-btn" href="/contacts" title="Kontak tersimpan">☷</a>
      <form method="post" action="/logout"><button class="icon-btn" title="Keluar">↪</button></form>
    </header>

    <div class="sidebar-tools">
      <div class="search-wrap"><input id="search" placeholder="Cari percakapan"></div>
      <div class="inbox-tabs">
        <button class="tab-btn active" data-mode="inbox">Chat</button>
        <button class="tab-btn" data-mode="archived">Arsip</button>
      </div>
    </div>

    <div id="conversationList" class="conversation-list"></div>
  </aside>

  <main class="chat-pane">
    <div id="emptyState" class="empty-state">
      <div class="empty-icon">💬</div>
      <h2>WhatsApp Inbox</h2>
      <p>Pilih percakapan untuk mulai membalas member.</p>
    </div>

    <section id="chatView" class="chat-view hidden">
      <header class="chat-head">
        <button id="mobileBack" class="mobile-back" type="button">‹</button>
        <div class="chat-person">
          <div class="avatar small">W</div>
          <div>
            <strong id="chatName">-</strong>
            <small id="chatPhone">-</small>
          </div>
        </div>
        <div class="chat-actions">
          <button id="archiveBtn" class="icon-action" type="button" title="Arsipkan">⌄</button>
          <button id="toggleStatus" class="secondary-btn" type="button">Tutup chat</button>
        </div>
      </header>

      <div id="messages" class="messages"></div>

      <div id="replyBar" class="reply-bar hidden">
        <div>
          <strong>Membalas</strong>
          <span id="replyText"></span>
        </div>
        <button id="cancelReply" type="button">×</button>
      </div>

      <div id="attachmentBar" class="attachment-bar hidden">
        <div id="attachmentName"></div>
        <button id="cancelAttachment" type="button">×</button>
      </div>

      <div id="sendError" class="send-error hidden"></div>

      <form id="composer" class="composer">
        <input id="fileInput" type="file" hidden
          accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip,.rar">
        <button id="attachBtn" class="composer-icon" type="button" title="Kirim gambar/dokumen">＋</button>
        <textarea id="messageInput" rows="1" placeholder="Ketik pesan"></textarea>
        <button id="sendBtn" class="send-button" type="submit" title="Kirim">➤</button>
      </form>
    </section>
  </main>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/app.js?v=1.7.0"></script>
</body>
</html>
