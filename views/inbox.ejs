<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>WA Inbox</title>
<link rel="stylesheet" href="/app.css">
</head>
<body>
<div id="app" class="wa-shell">
  <aside class="sidebar">
    <header class="sidebar-head">
      <div class="avatar">W</div>
      <strong>WhatsApp Inbox</strong>
      <form method="post" action="/logout"><button class="icon-btn" title="Keluar">↪</button></form>
    </header>
    <div class="search-wrap"><input id="search" placeholder="Cari atau mulai chat baru"></div>
    <div id="conversationList" class="conversation-list"></div>
  </aside>

  <main class="chat-pane">
    <div id="emptyState" class="empty-state">
      <div class="empty-icon">💬</div>
      <h2>WhatsApp Inbox</h2>
      <p>Pilih percakapan untuk mulai membalas member.</p>
    </div>

    <section id="chatView" class="chat-view hidden">
      <header class="chat-head">
        <div>
          <strong id="chatName">-</strong>
          <small id="chatPhone">-</small>
        </div>
        <div class="chat-actions">
          <button id="toggleStatus" class="secondary-btn">Tutup chat</button>
        </div>
      </header>
      <div id="messages" class="messages"></div>
      <div id="sendError" class="send-error hidden"></div>
      <form id="composer" class="composer">
        <textarea id="messageInput" rows="1" placeholder="Ketik pesan" required></textarea>
        <button id="sendBtn" type="submit" title="Kirim">➤</button>
      </form>
    </section>
  </main>
</div>
<script src="/socket.io/socket.io.js"></script>
<script src="/app.js"></script>
</body>
</html>
