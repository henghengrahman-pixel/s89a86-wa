<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>WA Inbox - Login</title>
<link rel="stylesheet" href="/css/base.css?v=1.6.0">
<link rel="stylesheet" href="/css/login.css?v=1.6.0">
</head>
<body class="login-page">
  <form class="login-card" method="post" action="/login">
    <div class="brand-mark">W</div>
    <h1>WA Inbox</h1>
    <p>Masuk ke dashboard percakapan.</p>
    <% if (error) { %><div class="error-box"><%= error %></div><% } %>
    <label>ID Admin<input name="username" autocomplete="username" required></label>
    <label>Password<input name="password" type="password" autocomplete="current-password" required></label>
    <button type="submit">Masuk</button>
  </form>
</body>
</html>
