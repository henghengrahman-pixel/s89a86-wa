<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Kontak Tersimpan - PIN</title>
<link rel="stylesheet" href="/css/base.css?v=1.6.0">
<link rel="stylesheet" href="/css/contacts.css?v=1.6.0">
</head>
<body class="contacts-page">
  <div class="contacts-lock-wrap">
    <div class="contacts-lock-card">
      <div class="brand-mark">🔒</div>
      <h1>Kontak Tersimpan</h1>
      <p>Masukkan PIN untuk membuka daftar nomor member.</p>
      <% if (error) { %><div class="error-box"><%= error %></div><% } %>
      <form method="post" action="/contacts/unlock" class="pin-form">
        <input
          name="pin"
          type="password"
          inputmode="numeric"
          autocomplete="off"
          maxlength="32"
          placeholder="Masukkan PIN"
          autofocus
          required
        >
        <button type="submit">Buka Kontak</button>
      </form>
      <a href="/" class="back-link">← Kembali ke Inbox</a>
    </div>
  </div>
</body>
</html>
